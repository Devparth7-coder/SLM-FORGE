# ── SLM-Forge Environment Configuration ──────────────────────────────────
# Copy this file to `.env` and fill in values. NEVER commit secrets.

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-in-production
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
AUTH_ENABLED=false

# Database
DATABASE_URL=postgresql+psycopg2://slmforge:slmforge@localhost:5432/slmforge

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/artifacts
# S3-compatible (optional):
# STORAGE_S3_BUCKET=slmforge-artifacts
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_ENDPOINT_URL=

# Default model (used if no model is explicitly selected)
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
MODEL_REVISION=main
MODEL_CACHE_DIR=./data/cache/models

# HuggingFace token (for gated models)
# HF_TOKEN=hf_xxx

# Weights & Biases
WANDB_ENABLED=false
WANDB_PROJECT=slm-forge
# WANDB_ENTITY=your-entity
# WANDB_API_KEY=

# Data paths
DATA_ROOT=./data
DATASETS_DIR=./data/datasets
ARTIFACTS_DIR=./data/artifacts
REPORTS_DIR=./data/reports

# Security
MAX_UPLOAD_SIZE_MB=100
ALLOWED_UPLOAD_EXTENSIONS=.json,.jsonl,.csv,.parquet,.py,.zip

# Hardware
# FORCE_CPU=true
TORCH_NUM_THREADS=4

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
